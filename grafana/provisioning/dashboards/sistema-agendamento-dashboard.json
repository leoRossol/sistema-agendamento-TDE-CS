{
  "dashboard": {
    "title": "Sistema Agendamento - Métricas",
    "tags": ["sistema-agendamento", "spring-boot"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Taxa de Requisições HTTP",
        "type": "graph",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "rate(http_server_requests_seconds_count{application=\"sistema-agendamento-reports\"}[1m])",
            "legendFormat": "{{method}} {{uri}} - {{status}}"
          }
        ]
      },
      {
        "id": 2,
        "title": "Latência P95 (ms)",
        "type": "graph",
        "gridPos": {
          "x": 12,
          "y": 0,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(http_server_requests_seconds_bucket{application=\"sistema-agendamento-reports\"}[5m])) * 1000",
            "legendFormat": "{{method}} {{uri}}"
          }
        ]
      },
      {
        "id": 3,
        "title": "Uso de Memória JVM",
        "type": "graph",
        "gridPos": {
          "x": 0,
          "y": 8,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "jvm_memory_used_bytes{application=\"sistema-agendamento-reports\"}",
            "legendFormat": "{{area}} - {{id}}"
          }
        ]
      },
      {
        "id": 4,
        "title": "Threads JVM",
        "type": "graph",
        "gridPos": {
          "x": 12,
          "y": 8,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "jvm_threads_live{application=\"sistema-agendamento-reports\"}",
            "legendFormat": "Threads Ativas"
          }
        ]
      }
    ],
    "schemaVersion": 16,
    "version": 0
  }
}
